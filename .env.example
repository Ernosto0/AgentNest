# Copy to .env (git-ignored). Never commit real secrets.
# Reference: docs/operations/environment-variables.md

# --- Core -------------------------------------------------------------------
# development | test | production
APP_ENV=development
DATABASE_URL=postgresql+psycopg://agentnest:agentnest@localhost:5433/agentnest
TEST_DATABASE_URL=postgresql+psycopg://agentnest:agentnest@localhost:5433/agentnest_test

# Development placeholder only. Production requires >= 32 random bytes
# (generate with: uv run python -m app.cli generate-key). The example value is refused in production.
SECRET_KEY=dev-only-change-me-dev-only-change-me

FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:8000
PRODUCT_NAME=AgentNest

# Must be true in production (HTTPS).
COOKIE_SECURE=false
# Sliding session lifetime (336 h = 14 days).
SESSION_TTL_HOURS=336

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (development) | json (production)
LOG_FORMAT=console

# Mounts /api/v1/dev/* and the dev panel. Must be false in production.
DEMO_TOOLS_ENABLED=true
# Password of the seeded demo users. The seed refuses to run in production.
DEMO_PASSWORD=demo-password

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_LEASE_SECONDS=120

# --- AI (Phase 3) -----------------------------------------------------------
# fake (deterministic, offline: the default for development, the demo and CI) | openai.
# Production refuses `fake`.
LLM_PROVIDER=fake
# Only needed with LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
# Verify the exact model ID against OpenAI's model list. Per-task overrides are optional:
# LLM_MODEL_INTERPRET_COMMAND, LLM_MODEL_EXTRACT_FACTS (DRAFT_REPLY / DRAFT_CONTENT in Phases 4-5).
LLM_MODEL_DEFAULT=gpt-6-luna
# Empty turns reasoning off; minimal | low | medium | high. Reasoning tokens count against each
# task's output-token limit, so keep it low for these short structured tasks.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CALLS_PER_WORKSPACE_PER_DAY=500
# Optional, for cost estimates: {"<model>": {"input_per_mtok": 0.0, "output_per_mtok": 0.0}}
LLM_PRICE_TABLE=
