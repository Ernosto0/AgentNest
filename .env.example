# Copy to .env (git-ignored). Never commit real secrets.
# Reference: docs/operations/environment-variables.md

# --- Core -------------------------------------------------------------------
# development | test | production
APP_ENV=development
DATABASE_URL=postgresql+psycopg://agentnest:agentnest@localhost:5433/agentnest
TEST_DATABASE_URL=postgresql+psycopg://agentnest:agentnest@localhost:5433/agentnest_test

# Development placeholder only. Production requires >= 32 random bytes
# (generate with: uv run python -m app.cli generate-key). The example value is refused in production.
SECRET_KEY=dev-only-change-me-dev-only-change-me

FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:8000
PRODUCT_NAME=AgentNest

# Must be true in production (HTTPS).
COOKIE_SECURE=false
# Sliding session lifetime (336 h = 14 days).
SESSION_TTL_HOURS=336

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (development) | json (production)
LOG_FORMAT=console

# Mounts /api/v1/dev/* and the dev panel. Must be false in production.
DEMO_TOOLS_ENABLED=true
# Password of the seeded demo users. The seed refuses to run in production.
DEMO_PASSWORD=demo-password

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_LEASE_SECONDS=120

# --- AI (Phase 3) -----------------------------------------------------------
# fake (deterministic, offline: the default for development, the demo and CI) | openai.
# Production refuses `fake`.
LLM_PROVIDER=fake
# Only needed with LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
# gpt-6-luna is the cheapest GPT-6 model (ID confirmed on OpenAI's model page, 2026-10-21).
# Per-task overrides are optional:
# LLM_MODEL_INTERPRET_COMMAND, LLM_MODEL_EXTRACT_FACTS (DRAFT_REPLY / DRAFT_CONTENT in Phases 4-5).
LLM_MODEL_DEFAULT=gpt-6-luna
# Empty turns reasoning off; minimal | low | medium | high. Reasoning tokens count against each
# task's output-token limit, so keep it low for these short structured tasks.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CALLS_PER_WORKSPACE_PER_DAY=500
# Optional, for cost estimates: {"<model>": {"input_per_mtok": 0.0, "output_per_mtok": 0.0}}
LLM_PRICE_TABLE=

# --- Instagram (Phase 4) -----------------------------------------------------
# Comma-separated provider kinds: mock (simulated, the default) | meta (Phase 7).
INSTAGRAM_ENABLED_PROVIDERS=mock
# Production only: permits mock accounts on demo workspaces.
ALLOW_SIMULATED_WORKSPACES=true
# Development placeholders. Production requires real values for the enabled providers.
MOCK_INSTAGRAM_APP_SECRET=dev-mock-instagram-app-secret
META_WEBHOOK_VERIFY_TOKEN=dev-meta-webhook-verify-token
META_APP_SECRET=
# --- Meta foundations (Phase 7; mock stays the credential-free default) --------
# Enabling meta requires all Meta credentials, a valid key ring, and S3 in every environment.
META_APP_ID=
META_GRAPH_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/instagram/callback
META_STORIES_ENABLED=true
# Generate with: uv run python -m app.cli generate-key --kind token-encryption
# k1:<base64-32-bytes>[,k2:<base64-32-bytes>]. Keep old IDs while old ciphertext exists.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
TOKEN_REFRESH_DAYS_BEFORE_EXPIRY=20
# Wait this long after the last customer message before drafting a reply (one draft per burst).
REPLY_DEBOUNCE_SECONDS=8
# How long an unconfirmed send is checked before it is reported as unconfirmed.
SEND_RECONCILE_WINDOW_MINUTES=10
# Circuit breaker: N transient failures within the window mark the account degraded; the
# provider is left alone for the cooldown, then probed by a health check.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_WINDOW_MINUTES=10
CIRCUIT_COOLDOWN_MINUTES=10

# --- Media (Phase 5) ---------------------------------------------------------
# local (default, demo) | s3. Every environment requires s3 when meta is enabled.
MEDIA_STORAGE_BACKEND=local
# Relative paths are under backend/. Uploaded images are stored here (git-ignored).
MEDIA_LOCAL_ROOT=./var/media
# Larger uploads are refused (413). 8 MB matches the Instagram image limit.
MEDIA_MAX_IMAGE_BYTES=8388608
# How long a publishing fetch reference stays valid.
MEDIA_PUBLIC_URL_TTL_SECONDS=3600
# Reserved: local-media tunnel serving is pending; this does not enable meta with local storage.
MEDIA_PUBLIC_BASE_URL=
# Optional endpoint: empty uses AWS. Set the provider's actual region for AWS; auto suits R2.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Mock Instagram: how long a new publishing container stays IN_PROGRESS before it is FINISHED.
SIM_CONTAINER_DELAY_SECONDS=2
# Posts per rolling 24 h; the mock refuses to publish beyond it. Conservative: 50 (OQ-18).
PUBLISH_DAILY_LIMIT=50

# --- Retention (Phase 6) -----------------------------------------------------
# Global values, in days; the daily cleanup jobs apply them (security-and-privacy.md section 8).
# Audit rows are never deleted, so there is no audit setting.
RETENTION_WEBHOOK_PAYLOAD_DAYS=30
RETENTION_INBOUND_EVENT_ROW_DAYS=90
RETENTION_AGENT_INPUT_DAYS=30
RETENTION_MESSAGE_TEXT_DAYS=365
RETENTION_NOTIFICATIONS_READ_DAYS=90
RETENTION_JOBS_SUCCEEDED_DAYS=7
RETENTION_JOBS_DEAD_DAYS=90
RETENTION_MEDIA_ORPHAN_DAYS=7
RETENTION_PUBLISHED_MEDIA_DAYS=90
